# ConnectHub AI Engine
# ====================
# Standalone AI backend service powering all ConnectHub AI capabilities.
# Completely independent from the Flutter application.
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.

# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
PROJECT_NAME=ConnectHub AI Engine
VERSION=1.0.0
DEBUG=true

# ─── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Google Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# ─── Firebase ───────────────────────────────────────────────────────────────
# Option 1: Path to a service account JSON file
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json

# Option 2: Inline JSON (base64-encoded) — preferred for Docker/Cloud
# FIREBASE_CREDENTIALS_JSON=<base64-encoded-service-account-json>

FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── File Upload Settings ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TEMP_DIRECTORY=storage/uploads
ALLOWED_UPLOAD_EXTENSIONS=.pdf
ALLOWED_UPLOAD_MIME_TYPES=application/pdf
ALLOWED_FILE_TYPES=application/pdf

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
