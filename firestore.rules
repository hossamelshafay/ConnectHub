rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Keys that differ between the existing document and the incoming write.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {

      allow read: if isSignedIn();

      // Signup: a user may only create their own document.
      allow create: if isSignedIn() && isOwner(userId);

      allow update: if isSignedIn() && (

        // ① Profile owner updating their own fields (name, email, etc.)
        //   Owners may NOT directly write counter fields; those are only
        //   reachable through the validated follow/unfollow paths below.
        (
          isOwner(userId) &&
          !changedKeys().hasAny(['followersCount', 'followingCount'])
        )

        ||

        // ② Updating followersCount (+1 on follow, -1 on unfollow or removal).
        (
          changedKeys().hasOnly(['followersCount']) &&
          (
            request.resource.data.get('followersCount', 0) ==
              resource.data.get('followersCount', 0) + 1 ||
            request.resource.data.get('followersCount', 0) ==
              resource.data.get('followersCount', 0) - 1
          )
        )

        ||

        // ③ Updating followingCount (+1 on follow, -1 on unfollow or removal).
        (
          changedKeys().hasOnly(['followingCount']) &&
          (
            request.resource.data.get('followingCount', 0) ==
              resource.data.get('followingCount', 0) + 1 ||
            request.resource.data.get('followingCount', 0) ==
              resource.data.get('followingCount', 0) - 1
          )
        )
      );

      // A user may delete their own profile document upon account deletion.
      allow delete: if isSignedIn() && isOwner(userId);

      // ── followers sub-collection ─────────────────────────────────────────────
      match /followers/{followerId} {
        allow read:  if isSignedIn();
        // The follower can add/remove themselves, OR the account owner can remove them.
        allow write: if isSignedIn() && (isOwner(followerId) || isOwner(userId));
      }

      // ── following sub-collection ─────────────────────────────────────────────
      match /following/{followingId} {
        allow read:  if isSignedIn();
        // The account owner can manage their following list, OR the followed user can remove their entry when removing a follower.
        allow write: if isSignedIn() && (isOwner(userId) || isOwner(followingId));
      }

      // ── notifications sub-collection ─────────────────────────────────────────
      match /notifications/{notificationId} {
        // Owner may read their notifications, or sender when cleaning up.
        allow read: if isSignedIn() && (
          isOwner(userId) ||
          resource.data.senderId == request.auth.uid
        );

        // Any signed-in user may create a notification for another user
        // (triggered by likes, comments, follows).
        // Self-notification is prevented in application code.
        allow create: if isSignedIn();

        // Only the owner may update (mark as read).
        allow update: if isSignedIn() && isOwner(userId);

        // Owner can delete their notifications, or sender when cleaning up on account deletion.
        allow delete: if isSignedIn() && (
          isOwner(userId) ||
          resource.data.senderId == request.auth.uid
        );
      }

      // ── presence sub-collection ──────────────────────────────────────────────
      match /presence/{statusDoc} {
        allow read:  if isSignedIn();
        allow write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Posts ─────────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      // Social interactions (likes, likeCount, commentCount) are updates too.
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && isOwner(resource.data.userId);

      // ── comments sub-collection ──────────────────────────────────────────────
      match /comments/{commentId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn() &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isOwner(resource.data.userId);
        allow delete: if isSignedIn() && (
          isOwner(resource.data.userId) ||
          isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.userId)
        );
      }
    }

    // ── Conversations ─────────────────────────────────────────────────────────

    match /conversations/{conversationId} {
      allow get:    if isSignedIn() &&
                       (resource == null ||
                        conversationId.matches('.*' + request.auth.uid + '.*') ||
                        request.auth.uid in resource.data.participants);
      allow list:   if isSignedIn() &&
                       request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
                       (conversationId.matches('.*' + request.auth.uid + '.*') ||
                        request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn() &&
                       (conversationId.matches('.*' + request.auth.uid + '.*') ||
                        request.auth.uid in resource.data.participants);

      // ── messages sub-collection ───────────────────────────────────────────
      match /messages/{messageId} {
        allow read:   if isSignedIn() &&
                         (conversationId.matches('.*' + request.auth.uid + '.*') ||
                          !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isSignedIn() &&
                         request.resource.data.senderId == request.auth.uid &&
                         (conversationId.matches('.*' + request.auth.uid + '.*') ||
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow update: if isSignedIn() && (
                         // Sender can edit or soft-delete
                         resource.data.senderId == request.auth.uid ||
                         // Any participant can mark as seen or delete-for-me
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'deletedFor'])
                       );
        allow delete: if isSignedIn() &&
                         (conversationId.matches('.*' + request.auth.uid + '.*') ||
                          resource.data.senderId == request.auth.uid ||
                          !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
      }
    }

    // ── Collection Group Rules (required for collectionGroup queries) ────────
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid
      );
    }

    match /{path=**}/notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }
  }
}
